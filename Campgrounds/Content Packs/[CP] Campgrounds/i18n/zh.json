  // 露营对话(普通村民)
  "villagers.generic.inviteAccepted1": "露营? 听起来很棒, 算我一个!$h",
  "villagers.generic.inviteRejected1": "我没兴趣, 抱歉.$s",

  "villagers.generic.likedDayOf1": "这真是个绝佳的露营地!$h",
