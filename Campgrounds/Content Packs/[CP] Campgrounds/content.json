    // Add the Mines campgrounds
    {
      "Action": "EditData",
      "Target": "Data/PeacefulEnd_Campgrounds/Campgrounds",
      "Entries": {
        "{{ModId}}_MinesCampground": {
          "Id": "{{ModId}}_MinesCampground",
          "ForceForageRefreshOnVisit": true,
          "PreviewTexturePath": "Data/PeacefulEnd_Campgrounds/Campgrounds/Textures/MineCampgroundPreview",
          "PreviewTextureScale": 4.0,
          "PlayerSpawnTile": {
            "X": 12,
            "Y": 11
          },
          "GuestSpawnTile": {
            "X": 24,
            "Y": 13
          },
          "MaxTentTileSize": {
            "Width": 5,
            "Height": 5
          },
          "Description": "For the type of camper that prefers to stare at stalactites instead of stars.",
          "RequireVehicle": false,
          "TravelTimeInHours": 1,

          "UnlockCondition": "WORLD_STATE_ID MAP_UNLOCKED_CAMPGROUND:{{ModId}}_MinesCampground",
          "UnlockHint": "Purchase the map from Clem after reaching the 20th floor in the mines."
        }
      }
    },
