{
  "Format": "2.9.0",
  "Changes": [
    {
      // Add maps
      "Action": "EditData",
      "Target": "Data/Locations",
      "Entries": {
        "{{ModId}}_CindersapPark": {
          "CreateOnLoad": {
            "MapPath": "Maps/{{ModId}}_CindersapPark"
          }
        },
        "{{ModId}}_CindersapParkShop": {
          "CreateOnLoad": {
            "MapPath": "Maps/{{ModId}}_CindersapParkShop"
          }
        },
        "{{ModId}}_CindersapParkGarage": {
          "CreateOnLoad": {
            "MapPath": "Maps/{{ModId}}_CindersapParkGarage"
          }
        }
      }
    },
    {
      "Action": "Load",
      "Target": "Maps/{{ModId}}_CindersapPark",
      "FromFile": "assets/maps/CindersapPark.tmx"
    },
    {
      "Action": "Load",
      "Target": "Maps/{{ModId}}_CindersapParkOvergrown",
      "FromFile": "assets/maps/CindersapParkOvergrown.tmx"
    },
    {
      "Action": "Load",
      "Target": "Maps/{{ModId}}_CindersapParkActive",
      "FromFile": "assets/maps/CindersapParkActive.tmx"
    },
    {
      "Action": "Load",
      "Target": "Maps/{{ModId}}_CindersapParkShop",
      "FromFile": "assets/maps/CindersapParkShop.tmx"
    },
    {
      "Action": "Load",
      "Target": "Maps/{{ModId}}_CindersapParkGarage",
      "FromFile": "assets/maps/CindersapParkGarage.tmx"
    },
    {
      "Action": "Load",
      "Target": "Maps/spring_cindersap",
      "FromFile": "assets/maps/spring_cindersap.png"
    },
    {
      "Action": "Load",
      "Target": "Maps/cindersap_interior",
      "FromFile": "assets/maps/cindersap_interior.png"
    },

    // Patch Forest map (closed)
    {
      "Action": "EditMap",
      "Target": "Maps/Forest",
      "FromFile": "assets/maps/ForestPatchClosed.tmx",
      "FromArea": {
        "X": 2,
        "Y": 0,
        "Width": 13,
        "Height": 7
      },
      "ToArea": {
        "X": 2,
        "Y": 0,
        "Width": 13,
        "Height": 7
      },
      "When": {
        "HasSeenEvent |contains=PeacefulEnd.Campgrounds.Events.CaretakerIntro": "false"
      }
    },
    {
      "Action": "EditMap",
      "Target": "Maps/Forest",
      "FromFile": "assets/maps/ForestPatchClosed.tmx",
      "FromArea": {
        "X": 4,
        "Y": 0,
        "Width": 11,
        "Height": 12
      },
      "ToArea": {
        "X": 4,
        "Y": 0,
        "Width": 11,
        "Height": 12
      },
      "When": {
        "HasSeenEvent |contains=PeacefulEnd.Campgrounds.Events.CaretakerIntro": "false"
      }
    },

    // Patch Forest map (open)
    {
      "Action": "EditMap",
      "Target": "Maps/Forest",
      "FromFile": "assets/maps/ForestPatch.tmx",
      "FromArea": {
        "X": 2,
        "Y": 0,
        "Width": 13,
        "Height": 7
      },
      "ToArea": {
        "X": 2,
        "Y": 0,
        "Width": 13,
        "Height": 7
      },
      "When": {
        "HasSeenEvent": "PeacefulEnd.Campgrounds.Events.CaretakerIntro"
      }
    },
    {
      "Action": "EditMap",
      "Target": "Maps/Forest",
      "FromFile": "assets/maps/ForestPatch.tmx",
      "FromArea": {
        "X": 4,
        "Y": 0,
        "Width": 11,
        "Height": 12
      },
      "ToArea": {
        "X": 4,
        "Y": 0,
        "Width": 11,
        "Height": 12
      },
      "When": {
        "HasSeenEvent": "PeacefulEnd.Campgrounds.Events.CaretakerIntro"
      }
    },

