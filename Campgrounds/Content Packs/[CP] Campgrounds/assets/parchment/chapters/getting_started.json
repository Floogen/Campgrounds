        "getting_started-2": {
          "Id": "getting_started-2",
          "ChapterId": "getting_started",
          "Elements": [
            {
              "Type": "Paragraph",
              "FontType": "Small",
              "Text": "On the campsite board, you will see a list of discovered campgrounds. Pick any site you'd like to visit, but keep in mind the following:\n    - Campsites take a while to reach, so plan your departure carefully.\n    - Some campsites require a vehicle to reach. Clem can lend you hers, but you'll need to fix it first!\n    - Bring some camping rations before heading out, which can be purchased from Clem.\n    - You can invite a friend by gifting them a Visitor Pass (also purchasable from Clem).",
              "Alignment": "Left",
              "MarginLeft": 12,
            }
          ],
          "Background": []
        },
        "getting_started-3": {
